{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supplier_evidence.schema.json",
  "title": "SupplierEvidence",
  "version": "0.2.0",
  "description": "Provenance for a claim about a supplier (role, product relevance, legal identity). External facts carry source + URL/record ref + observed_at (BR-35). Claims are generated from structured data, never LLM-authored (BR-09).",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "supplier_id", "claim", "evidence_type", "supports", "source_name", "observed_at", "verification_status", "confidence"],
  "properties": {
    "evidence_id": { "$ref": "common.schema.json#/$defs/uuid", "description": "UUIDv5('evidence:' + supplier_id + ':' + evidence_type + ':' + (source_url or source_record_ref))" },
    "supplier_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "claim": { "type": "string", "minLength": 3, "maxLength": 500, "description": "Short factual statement, e.g. 'Listed in ГИСП as producer of sterilized milk'." },
    "evidence_type": {
      "type": "string",
      "enum": ["PROCUREMENT_HISTORY", "OFFICIAL_REGISTRY", "LEGAL_REGISTRY", "FIRST_PARTY_PRODUCTION", "COMPANY_WEBSITE", "DEALER_CERTIFICATE", "PRODUCT_CATALOG"]
    },
    "supports": { "type": "string", "enum": ["MARKET_ROLE", "PRODUCT_RELEVANCE", "LEGAL_IDENTITY"] },
    "source_name": { "type": "string", "minLength": 2, "maxLength": 200, "description": "e.g. organizer_dataset_2024_2025, ГИСП, ЕГРЮЛ, company website" },
    "source_url": { "type": "string", "format": "uri", "pattern": "^https?://" },
    "source_record_ref": { "type": "string", "minLength": 1, "maxLength": 200, "description": "e.g. 'lot:5718896' for PROCUREMENT_HISTORY or a registry record number." },
    "observed_at": { "$ref": "common.schema.json#/$defs/datetime" },
    "verification_status": { "type": "string", "enum": ["VERIFIED", "UNVERIFIED"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "related_okpd2_codes": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/okpd2_code" }, "uniqueItems": true }
  },
  "allOf": [
    { "anyOf": [{ "required": ["source_url"] }, { "required": ["source_record_ref"] }] },
    {
      "if": { "properties": { "evidence_type": { "const": "PROCUREMENT_HISTORY" } } },
      "then": { "required": ["source_record_ref"], "properties": { "source_record_ref": { "pattern": "^lot:\\S+$" } } }
    }
  ]
}
