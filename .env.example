# Copy to .env to override the development defaults used by docker-compose.yml (never commit .env).
POSTGRES_DB=supplier_radar
POSTGRES_USER=supplier_radar
POSTGRES_PASSWORD=change_me_for_shared_hosts
POSTGRES_PORT=5432
# Inside containers the backend uses the service name `postgres` (set in docker-compose.yml).
# For host-side tools only:
DATABASE_URL=postgresql://supplier_radar:change_me_for_shared_hosts@localhost:5432/supplier_radar

# Optional OKPD2 verifier (disabled unless explicitly enabled). Keep the API key in .env only.
OKPD2_LLM_VERIFIER_ENABLED=0
OKPD2_LLM_BASE_URL=https://api.groq.com/openai/v1
OKPD2_LLM_MODEL=qwen/qwen3.8-27b
OKPD2_LLM_API_KEY=
OKPD2_LLM_TIMEOUT_SECONDS=0.65
